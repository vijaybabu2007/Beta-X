# ==============================================================================
# ReguFlow AI - Environment Configuration Template
# Problem Statement: SIH26262 (AICTE Approval Workflow Automation)
# NEVER commit production credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (Spring Boot 3 / Java 21)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. Database Connectivity (PostgreSQL)
# ------------------------------------------------------------------------------
# In local development ('dev' profile), in-memory H2 with Postgres compatibility is used.
# In 'postgres' profile, configure the following connection details:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reguflow_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# 256-bit Hex secret key for HS256 JWT signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. AI & Cloud Services
# ------------------------------------------------------------------------------
# Google Gemini Developer API Key (for advisory extraction & RAG assistance)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Google Cloud Document AI (OCR fallback for scanned PDFs)
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ------------------------------------------------------------------------------
# 5. Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=ReguFlow AI
VITE_APH_VERSION=APH-2024-27-v2.1
